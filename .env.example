# Copie para .env.local. Nada aqui é segredo; o projeto não usa chaves.
# true = modo proposta (mostra TODO-CONFIRMAR, faixa "protótipo" e selo "provisória" nas fotos)
# false = modo público (esconde tudo que não está confirmado)
VITE_PROPOSAL_MODE=true
# URL pública do deploy, sem barra no final (usada em og:url / og:image). Opcional.
VITE_SITE_URL=
